# Innowit One - Environment Configuration
# Copy to .env and fill in your values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/innowit_one?schema=public"

# Server
NODE_ENV=development
PORT=3001
HOST=localhost

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3002

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (for eTIMS client secrets, etc.)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# eTIMS (Kenya KRA)
ETIMS_SANDBOX_URL=https://etims-sandbox.kra.go.ke
ETIMS_PRODUCTION_URL=https://etims.kra.go.ke

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug