// Prisma Schema for Innowit One - Business Operating System
// Based on the BACKEND SCHEMA & DATA CONNECTIONS SPECIFICATION
// Database Engine: PostgreSQL 16+
// ORM: Prisma ORM

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. GLOBAL ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EXECUTIVE
  FINANCE_MANAGER
  ACCOUNTANT
  SALES_MANAGER
  SALES_REP
  PROCUREMENT_OFFICER
  INVENTORY_MANAGER
  HR_MANAGER
  PROJECT_MANAGER
  EMPLOYEE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum CurrencyCode {
  KES
  USD
  EUR
  GBP
}

enum DealStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED
}

enum DealCloseOutcome {
  WON
  LOST
}

enum CustomerLifecycle {
  LEAD
  ACTIVE
  INACTIVE
}

enum CustomerType {
  CORPORATE
  INDIVIDUAL
}

enum CRMActivityType {
  CALL
  MEETING
  NOTE
  EMAIL_LOGGED
  STAGE_CHANGE
  TASK_CREATED
  TASK_COMPLETED
  CONTACT_ADDED
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
  DEAL_REOPENED
  QUOTATION_GENERATED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  VALIDATED
  POSTED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum EtimsMode {
  OSCU // Online Sales Control Unit
  VSCU // Virtual Sales Control Unit
}

enum EtimsEnvironment {
  SANDBOX
  PRODUCTION
}

enum EtimsSubmissionStatus {
  PENDING
  IN_FLIGHT
  ACCEPTED
  REJECTED
  RETRY_SCHEDULED
  CANCELLED
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TaxClassification {
  STANDARD_16 // 16% VAT Kenya
  ZERO_RATED   // 0%
  EXEMPT
  WITHHOLDING
}

// ============================================================================
// 2. AUTHENTICATION & MULTI-BRANCH ORGANIZATIONS
// ============================================================================

model Organization {
  id                        String         @id @default(uuid())
  legalName                 String
  tradeName                 String?
  kraPin                    String         @unique
  vatNumber                 String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  branches                  Branch[]
  users                     User[]
  etimsConfigs              EtimsConfiguration[]
  accounts                  Account[]
  quotations                Quotation[]
  salesOrders               SalesOrder[]
  salesInvoices             SalesInvoice[]
  customerPayments          CustomerPayment[]
  creditNotes               CreditNote[]
  purchaseOrders            PurchaseOrder[]
  suppliers                 Supplier[]
  departments               Department[]
  employees                 Employee[]
  payrollRuns               PayrollRun[]
  channels                  Channel[]
  channelMembers            ChannelMember[]
  messages                  Message[]
  fileAttachments           FileAttachment[]
  reactions                 Reaction[]
  readCursors               ReadCursor[]
  notifications             Notification[]
  presenceSessions          PresenceSession[]
  meetings                  Meeting[]
  conversations             Conversation[]
  sharedNotes               SharedNote[]
  notificationPreferences   NotificationPreference[]
  customers                 Customer[]
  deals                     Deal[]
  tasks                     Task[]
  activities                CRMActivity[]
  salesRepQuotas            SalesRepQuota[]
  commissionRules           CommissionRule[]
  commissionRecords         CommissionRecord[]
  customFieldDefinitions    CustomFieldDefinition[]
  customFieldValues         CustomFieldValue[]
  savedViews                SavedView[]
  automationRules           AutomationRule[]
  importJobs                ImportJob[]

  // ---- Phase 4 accounting & financial engine ----
  accountingProfile         OrganizationAccountingProfile?
  fiscalYears               FiscalYear[]
  accountingPeriods         AccountingPeriod[]
  costCentres               CostCentre[]
  exchangeRates             ExchangeRate[]
  taxCodes                  TaxCode[]
  taxTransactions           TaxTransaction[]
  supplierBills             SupplierBill[]
  supplierPayments          SupplierPayment[]
  paymentAllocations        PaymentAllocation[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  bankAccounts              BankAccount[]
  bankStatements            BankStatement[]
  bankReconciliations       BankReconciliation[]
  bankMatches               BankMatch[]
  budgets                   Budget[]
  budgetLines               BudgetLine[]
  mpesaTransactions         MpesaTransaction[]
  domainEvents              DomainEventLog[]
  documentSequences         DocumentSequence[]
}

model Branch {
  id               String         @id @default(uuid())
  organizationId   String
  branchCode       String         // e.g. "00" for HQ
  name             String
  address          String?
  phone            String?
  email            String?
  isHq             Boolean        @default(false)
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users            User[]
  warehouses       Warehouse[]
  invoices         SalesInvoice[]
  purchaseOrders   PurchaseOrder[]
  channels         Channel[]
  customers        Customer[]
  journalEntries   JournalEntry[]

  @@unique([organizationId, branchCode])
}

model User {
  id                        String         @id @default(uuid())
  organizationId            String
  branchId                  String?
  email                     String         @unique
  passwordHash              String
  fullName                  String
  role                      UserRole       @default(EMPLOYEE)
  isActive                  Boolean        @default(true)
  avatarUrl                 String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                    Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee                  Employee?
  assignedDeals             Deal[]
  assignedTasks             Task[]
  reopenedDeals             Deal[]         @relation("DealReopenedBy")
  salesRepQuotas            SalesRepQuota[]
  auditLogs                 AuditLog[]
  messages                  Message[]
  channelMemberships        ChannelMember[]
  refreshTokens             RefreshToken[]
  reactions                 Reaction[]
  readCursors               ReadCursor[]
  notifications             Notification[]
  presenceSessions          PresenceSession[]
  meetings                  Meeting[]        @relation("MeetingStartedBy")
  meetingParticipations     MeetingParticipant[]
  conversations             ConversationParticipant[]
  createdConversations      Conversation[]   @relation("CreatedConversations")
  sharedNotes               SharedNote[]
  notificationPreference    NotificationPreference?
  dealStageHistory          DealStageHistory[]
  crmActivities             CRMActivity[]    @relation("CRMActivityActor")
  commissionRecords         CommissionRecord[]
  approvedCommissions       CommissionRecord[] @relation("CommissionApprovedBy")
  savedViews                SavedView[]
  importJobs                ImportJob[]        @relation("ImportJobCreatedBy")

  @@index([organizationId])
  @@index([branchId])
  @@index([email])
}

// ============================================================================
// 3. AUTH TOKENS
// ============================================================================

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// 4. COLLABORATION (CHANNELS, MESSAGES, NOTES)
// ============================================================================

model Channel {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  name             String
  description      String?
  isPrivate        Boolean        @default(false)
  createdById      String
  createdAt        DateTime       @default(now())
  topic            String?
  isArchived       Boolean        @default(false)
  archivedAt       DateTime?
  branchId         String?

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  members          ChannelMember[]
  messages         Message[]
  meetings         Meeting[]
  sharedNotes      SharedNote[]
  readCursors      ReadCursor[]

  @@index([organizationId, isArchived])
  @@index([branchId])
}

model ChannelMember {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  channelId        String
  userId           String
  joinedAt         DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel          Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  channelId        String?
  conversationId   String?
  senderId         String
  recipientId      String?        // Populated for Direct Messages (1:1)
  parentId         String?        // Populated for Thread replies
  threadRootId     String?        // Root of thread for flat queries
  content          String
  isPinned         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  editedAt         DateTime?
  editedById       String?
  deletedAt        DateTime?      // Soft delete tombstone
  deletedById      String?
  idempotencyKey   String?        @unique // Client-generated for deduplication

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel          Channel?               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation     Conversation?          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User                   @relation(fields: [senderId], references: [id], onDelete: Restrict)
  parent           Message?               @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Message[]              @relation("ThreadReplies")
  attachments      FileAttachment[]
  reactions        Reaction[]
  readCursors      ReadCursor[]

  @@index([organizationId, channelId, createdAt])
  @@index([organizationId, recipientId, createdAt])
  @@index([conversationId])
  @@index([threadRootId])
  @@index([parentId])
  @@index([idempotencyKey, senderId, channelId])
  @@index([idempotencyKey, senderId, recipientId])
}

model FileAttachment {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  messageId        String?
  fileName         String
  fileSize         Int
  mimeType         String
  storagePath      String
  uploadedAt       DateTime       @default(now())
  uploadStatus     UploadStatus   @default(COMPLETED)
  checksum         String?
  scannedAt        DateTime?
  scanStatus       ScanStatus?
  scanResultJson   String?        @db.Text

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  message          Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([organizationId, uploadStatus])
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}

enum ScanStatus {
  CLEAN
  INFECTED
  PENDING
  SKIPPED
}

// ============================================================================
// PHASE 2: COLLABORATION EXTENSIONS
// ============================================================================

model Reaction {
  id             String   @id @default(uuid())
  organizationId String
  messageId      String
  userId         String
  emoji          String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([organizationId])
  @@index([messageId])
  @@index([userId])
}

model ReadCursor {
  id               String   @id @default(uuid())
  organizationId   String
  userId           String
  channelId        String?
  recipientId      String?  // For DMs
  lastReadMessageId String?
  lastReadAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessage  Message?     @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, channelId])
  @@unique([userId, recipientId])
  @@index([organizationId])
  @@index([userId])
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String           // Recipient
  type           NotificationType
  title          String
  body           String?
  dataJson       String?          @db.Text // Flexible payload: { messageId, channelId, etc. }
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  readAt         DateTime?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, isRead])
  @@index([userId, createdAt])
  @@index([organizationId])
}

enum NotificationType {
  MENTION
  DIRECT_MESSAGE
  THREAD_REPLY
  REACTION
  CHANNEL_INVITE
  MESSAGE_PINNED
  HUDDLE_STARTED
  FILE_SHARED
  SYSTEM
}

model PresenceSession {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  socketId       String           @unique
  status         PresenceStatus   @default(ONLINE)
  lastHeartbeat  DateTime         @default(now())
  metadataJson   String?          @db.Text // { device, platform, appVersion }
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([socketId])
  @@index([lastHeartbeat])
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

model Meeting {
  id               String         @id @default(uuid())
  organizationId   String
  channelId        String?
  title            String?
  startedById      String
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  status           MeetingStatus  @default(SCHEDULED)
  meetingType      MeetingType    @default(GROUP)
  metadataJson     String?        @db.Text // { sfuUrl, recordingUrl, etc. }

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel          Channel?           @relation(fields: [channelId], references: [id], onDelete: SetNull)
  startedBy        User               @relation("MeetingStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  participants     MeetingParticipant[]

  @@index([organizationId])
  @@index([channelId])
  @@index([startedById])
  @@index([status])
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum MeetingType {
  DIRECT
  GROUP
  CHANNEL
}

model MeetingParticipant {
  id           String       @id @default(uuid())
  meetingId    String
  userId       String
  joinedAt     DateTime     @default(now())
  leftAt       DateTime?
  role         MeetingRole  @default(PARTICIPANT)

  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

enum MeetingRole {
  HOST
  CO_HOST
  PARTICIPANT
}

model Conversation {
  id           String   @id @default(uuid())
  organizationId String
  type         String   @default("DIRECT") // "DIRECT" | "GROUP"
  title        String?  // For group DMs
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  directKey    String?  @unique // For DIRECT: orgId:min(participantA,participantB):max(participantA,participantB)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User       @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId])
  @@index([createdById])
  @@index([directKey])
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  leftAt         DateTime?
  role           String   @default("MEMBER") // "MEMBER" | "ADMIN"

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model SharedNote {
  id               String           @id @default(uuid())
  organizationId   String
  channelId        String?
  title            String
  content          String           @db.Text // Markdown
  category         NoteCategory
  authorId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  isPinned         Boolean          @default(false)
  linkedEntityType LinkedEntityType?
  linkedEntityId   String?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel          Channel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  author           User             @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([channelId])
  @@index([authorId])
}

enum NoteCategory {
  FINANCE
  SALES
  COMPLIANCE
  ENGINEERING
  GENERAL
}

enum LinkedEntityType {
  CUSTOMER
  DEAL
  INVOICE
  PROJECT
}

model NotificationPreference {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String   @unique
  desktopEnabled  Boolean  @default(true)
  previewEnabled  Boolean  @default(false)
  quietHoursStart String?
  quietHoursEnd   String?
  mutedChannels   String[] @default([])
  mutedUsers      String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================================================
// 5. CRM (CUSTOMERS, DEALS, TASKS)
// ============================================================================

model Customer {
  id               String            @id @default(uuid())
  organizationId   String
  branchId         String?
  customerCode     String
  name             String
  companyName      String?
  kraPin           String?
  email            String?
  phone            String?
  billingAddress   String?
  creditLimit      Decimal           @default(0.00) @db.Decimal(14, 2)
  paymentTermsDays Int               @default(30)
  lifecycle        CustomerLifecycle @default(LEAD)
  type             CustomerType      @default(CORPORATE)
  leadSource       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deals            Deal[]
  salesOrders      SalesOrder[]
  invoices         SalesInvoice[]
  contacts         CustomerContact[]
  tasks            Task[]
  activities       CRMActivity[]

  @@index([kraPin])
  @@index([customerCode])
  @@index([organizationId])
  @@index([branchId])
  @@index([lifecycle])
  @@unique([organizationId, customerCode]) // audit fix SC-6: tenant-scoped
}

model CustomerContact {
  id               String         @id @default(uuid())
  customerId       String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  jobTitle         String?
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  activities       CRMActivity[]

  @@index([customerId])
  @@index([customerId, isPrimary])
}

model Deal {
  id                  String              @id @default(uuid())
  organizationId      String              // Denormalized for tenant scoping
  customerId          String
  assignedToId        String
  title               String
  value               Decimal             @db.Decimal(14, 2)
  currency            CurrencyCode        @default(KES)
  stage               DealStage           @default(NEW_LEAD)
  closeOutcome        DealCloseOutcome?   // Set when stage = CLOSED
  winProbability      Int                 @default(20) // Percentage 0 - 100
  expectedCloseDate   DateTime?
  lostReason          String?
  lostNotes           String?
  source              String?
  version             Int                 @default(1) // Optimistic locking
  closedAt            DateTime?           // Set when stage enters CLOSED, cleared on reopen
  wonQuotationNumber  String?             // Quotation generated when won
  reopenedAt          DateTime?
  reopenedById        String?
  reopenReason        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo          User                @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  reopenedBy          User?               @relation("DealReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  tasks               Task[]
  quotations          Quotation[]
  stageHistory        DealStageHistory[]
  activities          CRMActivity[]
  commissionRecords   CommissionRecord[]

  @@index([organizationId])
  @@index([customerId])
  @@index([assignedToId])
  @@index([stage])
  @@index([closeOutcome])
  @@index([closedAt])
  @@index([expectedCloseDate])
  @@index([createdAt])
}

model Task {
  id               String         @id @default(uuid())
  organizationId   String         // Denormalized for tenant scoping
  title            String
  description      String?
  priority         TaskPriority   @default(MEDIUM)
  status           TaskStatus     @default(PENDING)
  dueDate          DateTime?
  completedAt      DateTime?
  assignedToId     String
  customerId       String?
  dealId           String?
  projectId        String?
  salesOrderId     String?
  reminderAt       DateTime?
  snoozedUntil     DateTime?
  reminderSent     Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo       User           @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal             Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  activities       CRMActivity[]

  @@index([organizationId])
  @@index([assignedToId])
  @@index([customerId])
  @@index([dealId])
  @@index([projectId])
  @@index([salesOrderId])
  @@index([status])
  @@index([dueDate])
  @@index([reminderAt])
}

// ============================================================================
// 5B. CRM EXTENSIONS (Phase 3)
// ============================================================================

model DealStageHistory {
  id            String      @id @default(uuid())
  organizationId String     // Denormalized for tenant scoping
  dealId        String
  fromStage     DealStage?
  toStage       DealStage
  closeOutcome  DealCloseOutcome?
  winProbability Int        // Probability at time of transition
  changedById   String
  reason        String?     // Reason for stage change or close outcome
  createdAt     DateTime    @default(now())

  deal          Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  changedBy     User        @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([dealId])
  @@index([createdAt])
}

model CRMActivity {
  id            String           @id @default(uuid())
  organizationId String          // Denormalized for tenant scoping
  customerId    String
  dealId        String?
  contactId     String?
  taskId        String?
  type          CRMActivityType
  title         String
  description   String?
  metadataJson  String?         @db.Text // Flexible payload
  actorId       String
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal          Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact       CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor         User             @relation("CRMActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([customerId])
  @@index([dealId])
  @@index([contactId])
  @@index([taskId])
  @@index([type])
  @@index([occurredAt])
  @@index([actorId])
}

model SalesRepQuota {
  id              String      @id @default(uuid())
  organizationId  String
  userId          String
  periodStart     DateTime
  periodEnd       DateTime
  periodType      String      // "MONTHLY" | "QUARTERLY" | "ANNUAL"
  metric          String      // "REVENUE" | "DEALS_WON" | "WEIGHTED_PIPELINE"
  targetValue     Decimal     @db.Decimal(14, 2)
  currency        CurrencyCode @default(KES)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, periodStart, periodEnd, metric]) // Prevent overlapping quotas
  @@index([organizationId])
  @@index([userId])
  @@index([periodStart, periodEnd])
}

model CommissionRule {
  id              String      @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean     @default(true)
  basis           String      // "DEAL_VALUE" | "COLLECTED_AMOUNT"
  rateType        String      // "FLAT" | "TIERED"
  rateValue       Decimal     @db.Decimal(5, 2) // Percentage or flat rate
  tierJson        String?     @db.Text // For tiered: [{min, max, rate}, ...]
  eligibleDealStages String[]  // Which stages qualify
  excludedDealSources String[]  @default([]) // Sources to exclude
  requiresApproval Boolean    @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  commissionRecords CommissionRecord[]

  @@index([organizationId])
  @@index([effectiveFrom, effectiveTo])
  @@index([isActive])
}

model CommissionRecord {
  id              String      @id @default(uuid())
  organizationId  String
  ruleId          String
  dealId          String
  userId          String      // Sales rep who earns commission
  amount          Decimal     @db.Decimal(14, 2)
  currency        CurrencyCode @default(KES)
  basisAmount     Decimal     @db.Decimal(14, 2) // Deal value or collected amount used
  rateApplied     Decimal     @db.Decimal(5, 2)
  status          String      @default("PENDING") // "PENDING" | "APPROVED" | "PAID" | "CANCELLED"
  approvedAt      DateTime?
  approvedById    String?
  paidAt          DateTime?
  calculationKey  String      // Deterministic key to prevent recalculation duplicates
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rule            CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  deal            Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedBy      User?        @relation("CommissionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([calculationKey]) // Prevent duplicate commission calculations
  @@index([organizationId])
  @@index([ruleId])
  @@index([dealId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model CustomFieldDefinition {
  id              String      @id @default(uuid())
  organizationId  String
  entityType      String      // "CUSTOMER" | "CONTACT" | "DEAL"
  fieldKey        String
  label           String
  fieldType       String      // "TEXT" | "NUMBER" | "DATE" | "BOOLEAN" | "SELECT" | "MULTI_SELECT"
  optionsJson     String?     @db.Text // For SELECT/MULTI_SELECT: ["opt1", "opt2"]
  isRequired      Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  values          CustomFieldValue[]

  @@unique([organizationId, entityType, fieldKey])
  @@index([organizationId])
  @@index([entityType])
}

model CustomFieldValue {
  id                  String      @id @default(uuid())
  organizationId      String
  definitionId        String
  entityId            String      // Customer/Contact/Deal ID
  valueJson           String      @db.Text // Stores value as JSON
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition          CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([organizationId])
  @@index([entityId])
}

model SavedView {
  id              String      @id @default(uuid())
  organizationId  String
  userId          String
  entityType      String      // "CUSTOMER" | "DEAL" | "TASK"
  name            String
  filtersJson     String      @db.Text
  sortJson        String      @db.Text
  columnsJson     String?     @db.Text
  isDefault       Boolean     @default(false)
  isShared        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType])
}

model AutomationRule {
  id               String      @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  trigger          String
  conditionsJson   String      @db.Text
  actionType       String
  actionConfigJson String      @db.Text
  targetRole       String      @default("ALL")
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  executionLogs    AutomationExecutionLog[]

  @@index([organizationId])
  @@index([trigger])
  @@index([isActive])
}

model AutomationExecutionLog {
  id                 String      @id @default(uuid())
  ruleId             String
  ruleName           String
  trigger            String
  status             String      @default("SUCCESS") // "SUCCESS" | "WARNING" | "SKIPPED" | "FAILED"
  matchedEntityCount Int         @default(0)
  details            String?     @db.Text
  executedAt         DateTime    @default(now())

  rule               AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([executedAt])
}

model ImportJob {
  id                  String      @id @default(uuid())
  organizationId      String
  entityType          String      // "CUSTOMER" | "CONTACT" | "DEAL" | "TASK" | "ACTIVITY"
  fileUrl             String
  mappingJson         String      @db.Text
  status              ImportJobStatus @default(PENDING)
  optionsJson         String?     @db.Text
  idempotencyKey      String?
  processedCount      Int         @default(0)
  succeededCount      Int         @default(0)
  failedCount         Int         @default(0)
  skippedCount        Int         @default(0)
  errorJson           String?     @db.Text
  createdById         String
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy           User        @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([status])
  @@index([entityType])
  @@index([createdById])
  @@index([createdAt])
}

// ============================================================================
// 6. ACCOUNTING CORE & GENERAL LEDGER
// ============================================================================

model Account {
  id               String         @id @default(uuid())
  organizationId   String
  accountNumber    String         // e.g., "1010"
  name             String         // e.g., "Cash on Hand"
  type             AccountType
  currency         CurrencyCode   @default(KES)
  isActive         Boolean        @default(true)
  currentBalance   Decimal        @default(0.00) @db.Decimal(14, 2)

  // ---- Phase 4: hierarchy, classification and posting rules ----
  parentId         String?
  description      String?
  subtype          String?                             // e.g. "CURRENT_ASSET", "COST_OF_SALES"
  normalBalance    AccountNormalBalance @default(DEBIT)
  isPostable       Boolean        @default(true)       // summary/header accounts are false
  isControl        Boolean        @default(false)      // control accounts cannot be posted to directly
  controlType      AccountControlType @default(NONE)
  isSystem         Boolean        @default(false)      // seeded control accounts cannot be deleted
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent           Account?       @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Account[]      @relation("AccountHierarchy")
  journalLines     JournalLine[]
  bankAccounts     BankAccount[]
  budgetLines      BudgetLine[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([parentId])
  @@index([organizationId, controlType])
}

model JournalEntry {
  id               String         @id @default(uuid())
  organizationId   String
  entryNumber      String // e.g. "JE-2026-0001"
  postingDate      DateTime
  sourceModule     String         // e.g. "SALES_INVOICE", "PAYROLL", "MANUAL"
  sourceId         String?        // ID of originating invoice, bill, etc.
  description      String
  isReversed       Boolean        @default(false)
  reversalEntryId  String?        @unique
  createdAt        DateTime       @default(now())

  // ---- Phase 4: lifecycle, period locking, dimensions, FX, idempotency ----
  status           JournalStatus  @default(POSTED) // legacy rows are already in the ledger
  branchId         String?
  periodId         String?
  currency         CurrencyCode   @default(KES)
  exchangeRate     Decimal        @default(1.00000000) @db.Decimal(18, 8)
  sourceKey        String?        // idempotency key supplied by the source module
  transactionRef   String?        // external document reference
  postedAt         DateTime?
  postedBy         String?
  approvedAt       DateTime?
  approvedBy       String?
  createdBy        String?
  reversalReason   String?
  updatedAt        DateTime       @updatedAt

  lines            JournalLine[]
  period           AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reversalEntry    JournalEntry?  @relation("JournalReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  reversedEntry    JournalEntry?  @relation("JournalReversal")

  @@unique([organizationId, entryNumber]) // audit fix SC-6: tenant-scoped
  @@unique([organizationId, sourceKey])
  @@index([postingDate])
  @@index([sourceModule, sourceId])
  @@index([organizationId])
  @@index([organizationId, postingDate])
  @@index([periodId])
  @@index([status])
  @@index([branchId])
}

model JournalLine {
  id               String         @id @default(uuid())
  journalEntryId   String
  accountId        String
  description      String?
  debit            Decimal        @default(0.00) @db.Decimal(14, 2)
  credit           Decimal        @default(0.00) @db.Decimal(14, 2)

  // ---- Phase 4: transaction currency, functional-currency amounts, dimensions ----
  currency         CurrencyCode   @default(KES)
  fxRate           Decimal        @default(1.00000000) @db.Decimal(18, 8)
  baseDebit        Decimal        @default(0.00) @db.Decimal(14, 2)
  baseCredit       Decimal        @default(0.00) @db.Decimal(14, 2)
  costCentreId     String?
  dimensionTag     String?

  journalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCentre       CostCentre?    @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([journalEntryId])
  @@index([costCentreId])
}

// ============================================================================
// 7. INVENTORY & WAREHOUSING
// ============================================================================

model Product {
  id               String         @id @default(uuid())
  organizationId   String
  sku              String
  barcode          String?
  name             String
  description      String?
  uom              String         @default("PCS") // Unit of measure
  costPrice        Decimal        @db.Decimal(14, 2)
  sellingPrice     Decimal        @db.Decimal(14, 2)
  taxClassification TaxClassification @default(STANDARD_16)
  reorderLevel     Int            @default(10)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stockLevels      WarehouseStock[]
  movements        StockMovement[]
  invoiceItems     SalesInvoiceItem[]
  orderItems       SalesOrderItem[]
  quotationItems   QuotationItem[]

  @@index([organizationId])
  @@index([sku])
  @@unique([organizationId, sku]) // audit fix SC-6: tenant-scoped
}

model Warehouse {
  id               String         @id @default(uuid())
  branchId         String
  name             String
  code             String
  location         String?

  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stockLevels      WarehouseStock[]
  movements        StockMovement[]

  @@unique([branchId, code]) // audit fix SC-6: branch(tenant)-scoped
  @@index([branchId])
}

model WarehouseStock {
  id               String         @id @default(uuid())
  productId        String
  warehouseId      String
  quantityOnHand   Decimal        @default(0.00) @db.Decimal(12, 2)
  quantityReserved Decimal        @default(0.00) @db.Decimal(12, 2)

  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model StockMovement {
  id               String         @id @default(uuid())
  productId        String
  warehouseId      String
  movementType     StockMovementType
  quantity         Decimal        @db.Decimal(12, 2)
  unitCost         Decimal        @db.Decimal(14, 2)
  referenceDocument String?       // e.g., "GRN-2026-0012" or "INV-2026-0045"
  notes            String?
  timestamp        DateTime       @default(now())

  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId])
  @@index([timestamp])
}

// ============================================================================
// 8. SALES, INVOICING & CREDIT NOTES
// ============================================================================

model Quotation {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: direct tenant scoping
  dealId           String?        @unique
  quotationNumber  String
  validUntil       DateTime
  totalAmount      Decimal        @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deal             Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  salesOrder       SalesOrder?
  items            QuotationItem[]

  @@unique([organizationId, quotationNumber]) // audit fix SC-6: tenant-scoped
}

model QuotationItem {
  id               String         @id @default(uuid())
  quotationId      String
  productId        String
  description      String?
  quantity         Decimal        @db.Decimal(12, 2)
  unitPrice        Decimal        @db.Decimal(14, 2)
  taxRate          Decimal        @default(16.00) @db.Decimal(5, 2)

  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
}

model SalesOrder {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: direct tenant scoping
  quotationId      String?        @unique
  customerId       String
  orderNumber      String
  orderStatus      OrderStatus    @default(DRAFT)
  totalAmount      Decimal        @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotation        Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            SalesOrderItem[]
  invoice          SalesInvoice?

  @@unique([organizationId, orderNumber]) // audit fix SC-6: tenant-scoped
  @@index([customerId])
  @@index([orderStatus])
}

model SalesOrderItem {
  id               String         @id @default(uuid())
  salesOrderId     String
  productId        String
  quantity         Decimal        @db.Decimal(12, 2)
  unitPrice        Decimal        @db.Decimal(14, 2)
  taxRate          Decimal        @default(16.00) @db.Decimal(5, 2)
  totalAmount      Decimal        @db.Decimal(14, 2)

  salesOrder       SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict) // audit fix SC-1: was Cascade — order items are financial line records
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
}

model SalesInvoice {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: direct tenant scoping
  branchId         String
  customerId       String
  salesOrderId     String?        @unique
  invoiceNumber    String // Local sequence e.g. "INV-2026-0042"
  invoiceDate      DateTime
  dueDate          DateTime
  status           InvoiceStatus  @default(DRAFT)
  isSandbox        Boolean        @default(false)
  subtotal         Decimal        @db.Decimal(14, 2)
  taxAmount        Decimal        @db.Decimal(14, 2)
  totalAmount      Decimal        @db.Decimal(14, 2)
  paidAmount       Decimal        @default(0.00) @db.Decimal(14, 2)
  createdAt        DateTime       @default(now())

  // ---- Phase 4: posting provenance, FX snapshot, tax snapshot ----
  currency         CurrencyCode   @default(KES)
  exchangeRate     Decimal        @default(1.00000000) @db.Decimal(18, 8)
  postedJournalId  String?
  journalPostedAt  DateTime?
  taxSnapshotJson  String?        @db.Text

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder       SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  items            SalesInvoiceItem[]
  payments         CustomerPayment[]
  creditNotes      CreditNote[]
  etimsInvoice     EtimsInvoice?
  transmissionJobs EtimsTransmissionQueue[]
  allocations      PaymentAllocation[]

  @@unique([organizationId, invoiceNumber]) // audit fix SC-6: tenant-scoped
  @@index([status])
  @@index([invoiceDate])
  @@index([branchId])
  @@index([customerId])
  @@index([postedJournalId])
  @@index([organizationId, customerId, status])
}

model SalesInvoiceItem {
  id               String         @id @default(uuid())
  salesInvoiceId   String
  productId        String
  description      String
  quantity         Decimal        @db.Decimal(12, 2)
  unitPrice        Decimal        @db.Decimal(14, 2)
  taxClassification TaxClassification @default(STANDARD_16)
  taxAmount        Decimal        @db.Decimal(14, 2)
  lineTotal        Decimal        @db.Decimal(14, 2)

  salesInvoice     SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict) // audit fix SC-2: was Cascade — invoice line items are financial records
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesInvoiceId])
  @@index([productId])
}

model CustomerPayment {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: direct tenant scoping
  salesInvoiceId   String?        // Phase 4: nullable to allow unapplied cash / on-account receipts
  paymentNumber    String
  paymentDate      DateTime
  amount           Decimal        @db.Decimal(14, 2)
  paymentMethod    String         // e.g. "M-PESA", "BANK_TRANSFER", "CASH"
  referenceCode    String         // e.g. M-Pesa receipt code "QG721HD89"
  createdAt        DateTime       @default(now())

  // ---- Phase 4: unapplied cash, allocation status, FX, provenance ----
  customerId       String?
  branchId         String?
  currency         CurrencyCode   @default(KES)
  exchangeRate     Decimal        @default(1.00000000) @db.Decimal(18, 8)
  unappliedAmount  Decimal        @default(0.00) @db.Decimal(14, 2)
  status           PaymentStatus  @default(POSTED)
  providerRef      String?        // M-Pesa receipt / bank transaction reference
  bankAccountId    String?
  postedJournalId  String?
  postedAt         DateTime?
  createdBy        String?

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesInvoice     SalesInvoice?  @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  allocations      PaymentAllocation[]

  @@unique([organizationId, paymentNumber]) // audit fix SC-6: tenant-scoped
  @@unique([organizationId, providerRef])
  @@index([salesInvoiceId])
  @@index([paymentDate])
  @@index([organizationId, customerId, paymentDate])
}

model CreditNote {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: direct tenant scoping
  salesInvoiceId   String
  creditNoteNumber String
  reason           String
  totalAmount      Decimal        @db.Decimal(14, 2)
  taxAmount        Decimal        @db.Decimal(14, 2)
  issuedAt         DateTime       @default(now())

  // ---- Phase 4: lifecycle, posting provenance, FX ------------------------------
  status           CreditNoteStatus @default(DRAFT)
  branchId         String?
  customerPaymentId String?
  currency         CurrencyCode   @default(KES)
  exchangeRate     Decimal        @default(1.00000000) @db.Decimal(18, 8)
  subtotal         Decimal        @default(0.00) @db.Decimal(14, 2)
  postedJournalId  String?
  postedAt         DateTime?
  createdBy        String?

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesInvoice     SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, creditNoteNumber]) // audit fix SC-6: tenant-scoped
  @@index([salesInvoiceId])
}

// ============================================================================
// 9. KENYA eTIMS TAX COMPLIANCE MODELS
// ============================================================================

model EtimsConfiguration {
  id               String         @id @default(uuid())
  organizationId   String
  mode             EtimsMode      @default(OSCU)
  environment      EtimsEnvironment @default(SANDBOX)
  taxpayerPin      String
  branchCode       String         @default("00")
  deviceSerial     String?
  clientSecretEnc  String         // AES-256 encrypted
  apiUrl           String
  isCertified      Boolean        @default(false)
  isProductionActive Boolean      @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, environment])
}

model EtimsInvoice {
  id               String         @id @default(uuid())
  salesInvoiceId   String         @unique
  kraControlNumber String         @unique // KRA issued Control Number
  internalData     String         // Cryptographic signature hash
  qrCodeUrl        String
  submissionDate   DateTime       @default(now())
  ackCode          String         // e.g. "00" for success

  salesInvoice     SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
}

model EtimsTransmissionQueue {
  id               String         @id @default(uuid())
  salesInvoiceId   String
  idempotencyKey   String         @unique
  status           EtimsSubmissionStatus @default(PENDING)
  payloadJson      String         @db.Text
  responseJson     String?        @db.Text
  attemptCount     Int            @default(0)
  lastError        String?
  nextRetryAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  salesInvoice     SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict) // audit fix SC-3: was Cascade — KRA transmission records are tax-compliance evidence

  @@index([salesInvoiceId]) // audit fix SC-30: FK column was unindexed
  @@index([status, nextRetryAt])
}

// ============================================================================
// 10. PROCUREMENT & SUPPLIERS
// ============================================================================

model Supplier {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  name             String
  kraPin           String?
  email            String?
  phone            String?
  paymentTermsDays Int            @default(30)
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders   PurchaseOrder[]
  bills            SupplierBill[]
  payments         SupplierPayment[]

  @@index([organizationId])
}

model PurchaseOrder {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: direct tenant scoping
  branchId         String
  supplierId       String
  poNumber         String
  orderDate        DateTime
  totalAmount      Decimal        @db.Decimal(14, 2)
  isApproved       Boolean        @default(false)
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier         Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([organizationId, poNumber]) // audit fix SC-6: tenant-scoped
  @@index([branchId])
  @@index([supplierId])
}

// ============================================================================
// 11. HR & PAYROLL
// ============================================================================

model Department {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  name             String
  employees        Employee[]

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name]) // audit fix SC-6: tenant-scoped
}

model Employee {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  userId           String         @unique
  departmentId     String
  employeeCode     String
  nationalId       String?
  kraPin           String?
  nssfNumber       String?
  nhifNumber       String?
  basicSalary      Decimal        @db.Decimal(14, 2)
  hireDate         DateTime
  isActive         Boolean        @default(true)

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  department       Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  payslips         Payslip[]

  @@unique([organizationId, employeeCode]) // audit fix SC-6: tenant-scoped
  @@index([departmentId])
  @@index([userId])
}

model PayrollRun {
  id               String         @id @default(uuid())
  organizationId   String         // audit fix SC-23: tenant scoping
  month            Int
  year             Int
  totalGross       Decimal        @db.Decimal(14, 2)
  totalTax         Decimal        @db.Decimal(14, 2)
  totalNet         Decimal        @db.Decimal(14, 2)
  isApproved       Boolean        @default(false)
  postedToGl       Boolean        @default(false)
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payslips         Payslip[]

  @@unique([organizationId, month, year]) // audit fix SC-6: tenant-scoped
}

model Payslip {
  id               String         @id @default(uuid())
  payrollRunId     String
  employeeId       String
  basicSalary      Decimal        @db.Decimal(14, 2)
  allowances       Decimal        @default(0.00) @db.Decimal(14, 2)
  grossPay         Decimal        @db.Decimal(14, 2)
  payeTax          Decimal        @db.Decimal(14, 2)
  nssfDeduction    Decimal        @db.Decimal(14, 2)
  nhifDeduction    Decimal        @db.Decimal(14, 2)
  housingLevy      Decimal        @db.Decimal(14, 2)
  netPay           Decimal        @db.Decimal(14, 2)

  payrollRun       PayrollRun     @relation(fields: [payrollRunId], references: [id], onDelete: Restrict) // audit fix SC-4: was Cascade — payslips are payroll financial records
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([payrollRunId])
  @@index([employeeId])
}

// ============================================================================
// 12. AUDIT & SYSTEM UTILITIES
// ============================================================================

model AuditLog {
  id               String         @id @default(uuid())
  userId           String?
  action           String         // "CREATE", "UPDATE", "DELETE", "POST", "APPROVE"
  entityType       String         // "SalesInvoice", "JournalEntry", etc.
  entityId         String
  changesJson      String?        @db.Text
  ipAddress        String?
  timestamp        DateTime       @default(now())

  // ---- Phase 4: tenant-scoped audit queries (no join required) ----
  organizationId   String?
  branchId         String?
  correlationId    String?

  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
  @@index([organizationId, timestamp])
  @@index([correlationId])
}

// ============================================================================
// PHASE 4 — ACCOUNTING & FINANCIAL ENGINE
// Additive only. No existing table is dropped or renamed.
// ============================================================================

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REVERSED
  VOID
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum AccountControlType {
  NONE
  CUSTOMER_AR
  SUPPLIER_AP
  BANK
  CASH
  MPESA
  VAT_OUTPUT
  VAT_INPUT
  WHT_PAYABLE
  INVENTORY
  PAYROLL
  RETAINED_EARNINGS
  FX_GAIN_LOSS
  SUSPENSE
}

enum TaxKind {
  VAT_STANDARD
  VAT_ZERO
  VAT_EXEMPT
  VAT_REVERSE_CHARGE
  WHT_INCOME
  WHT_VAT
  NONE
}

enum TaxApplicability {
  SALES
  PURCHASE
  BOTH
}

enum PaymentStatus {
  DRAFT
  POSTED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
  REVERSED
}

enum CreditNoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  APPLIED
  CANCELLED
}

enum SupplierBillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BankAccountType {
  BANK
  CASH
  MPESA
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  EXCLUDED
}

enum ReconciliationStatus {
  DRAFT
  FINALIZED
  REVERSED
}

enum ReconciliationMatchType {
  AUTO_EXACT
  AUTO_PARTIAL
  MANUAL
  MULTI_LINE
  BANK_FEE
}

enum ExchangeRateSource {
  CBK
  MANUAL
  CONTRACTUAL
  PROVIDER
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

enum MpesaTransactionType {
  STK_PUSH
  C2B
  B2C
}

enum MpesaTransactionStatus {
  REQUESTED
  ACKNOWLEDGED
  CONFIRMED
  FAILED
  CANCELLED
  QUARANTINED
}

enum DomainEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

// ---------------------------------------------------------------------------
// 1. Organization accounting profile
// ---------------------------------------------------------------------------

model OrganizationAccountingProfile {
  id                        String         @id @default(uuid())
  organizationId            String         @unique
  functionalCurrency        CurrencyCode   @default(KES)
  fiscalYearStartMonth      Int            @default(1)
  fiscalYearStartDay        Int            @default(1)
  timezone                  String         @default("Africa/Nairobi")
  isVatRegistered           Boolean        @default(true)
  vatNumber                 String?
  whtAgent                  Boolean        @default(false)
  allowSelfApproval         Boolean        @default(false)
  journalApprovalThreshold  Decimal        @default(0.00) @db.Decimal(14, 2)
  billApprovalThreshold     Decimal        @default(0.00) @db.Decimal(14, 2)
  paymentApprovalThreshold  Decimal        @default(0.00) @db.Decimal(14, 2)

  // Control-account mapping (must point at this organization's own accounts)
  arControlAccountId        String?
  apControlAccountId        String?
  vatOutputAccountId        String?
  vatInputAccountId         String?
  whtPayableAccountId       String?
  suspenseAccountId         String?
  fxGainAccountId           String?
  fxLossAccountId           String?
  retainedEarningsAccountId String?

  // Default accounts for document flows that carry no account on the document
  // line (a sales invoice line names a product, not a revenue account).
  defaultRevenueAccountId   String?
  defaultExpenseAccountId   String?
  defaultCashAccountId      String?

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------
// 2. Fiscal years and accounting periods
// ---------------------------------------------------------------------------

model FiscalYear {
  id             String           @id @default(uuid())
  organizationId String
  name           String           // e.g. "FY2026"
  startDate      DateTime
  endDate        DateTime
  status         FiscalYearStatus @default(OPEN)
  closedAt       DateTime?
  closedBy       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  periods        AccountingPeriod[]
  budgets        Budget[]

  @@unique([organizationId, name])
  @@unique([organizationId, startDate])
  @@index([organizationId, status])
}

model AccountingPeriod {
  id             String       @id @default(uuid())
  organizationId String
  fiscalYearId   String
  name           String       // e.g. "2026-01"
  periodNumber   Int          // 1..12
  startDate      DateTime
  endDate        DateTime
  status         PeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedBy       String?
  reopenedAt     DateTime?
  reopenedBy     String?
  reopenReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([organizationId, fiscalYearId, periodNumber])
  @@unique([organizationId, startDate])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// 3. Cost centres / dimensions
// ---------------------------------------------------------------------------

model CostCentre {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  departmentId   String?      // links to existing Department; validated in service
  parentId       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent         CostCentre?  @relation("CostCentreHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       CostCentre[] @relation("CostCentreHierarchy")
  journalLines   JournalLine[]
  budgetLines    BudgetLine[]
  billLines      SupplierBillLine[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// 4. Foreign exchange rates
// ---------------------------------------------------------------------------

model ExchangeRate {
  id             String             @id @default(uuid())
  organizationId String
  fromCurrency   CurrencyCode
  toCurrency     CurrencyCode
  rate           Decimal            @db.Decimal(18, 8)
  rateDate       DateTime
  source         ExchangeRateSource @default(CBK)
  sourceRef      String?            // e.g. CBK indicative rate URL / circular reference
  isOverride     Boolean            @default(false)
  overrideReason String?
  approvedBy     String?
  approvedAt     DateTime?
  createdBy      String?
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, fromCurrency, toCurrency, rateDate, source])
  @@index([organizationId, fromCurrency, toCurrency, rateDate])
}

// ---------------------------------------------------------------------------
// 5. Tax rules (effective-dated) and tax transaction snapshots
// ---------------------------------------------------------------------------

model TaxCode {
  id                  String          @id @default(uuid())
  organizationId      String
  code                String          // e.g. "KE-VAT-STD", "KE-WHT-SERVICES-RESIDENT"
  name                String
  kind                TaxKind
  applicability       TaxApplicability @default(BOTH)
  ratePercent         Decimal         @db.Decimal(7, 4)
  isRecoverable       Boolean         @default(true)
  isCompound          Boolean         @default(false)
  reverseCharge       Boolean         @default(false)
  whtRecipientType    String?         // RESIDENT / NON_RESIDENT / UNKNOWN
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  glOutputAccountId   String?
  glInputAccountId    String?
  glLiabilityAccountId String?
  isActive            Boolean         @default(true)
  version             Int             @default(1)
  supersedesId        String?
  legalRef            String?         // e.g. "VAT Act 2013 s.5(1)"
  notes               String?
  createdBy           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactions        TaxTransaction[]

  @@unique([organizationId, code, effectiveFrom])
  @@index([organizationId, kind, effectiveFrom])
  @@index([organizationId, isActive])
}

model TaxTransaction {
  id               String       @id @default(uuid())
  organizationId   String
  taxCodeId        String
  sourceType       String       // SALES_INVOICE / SUPPLIER_BILL / CREDIT_NOTE / JOURNAL
  sourceId         String
  taxKind          TaxKind
  taxableBase      Decimal      @db.Decimal(14, 2)
  ratePercent      Decimal      @db.Decimal(7, 4)
  taxAmount        Decimal      @db.Decimal(14, 2)
  currency         CurrencyCode @default(KES)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  ruleSnapshotJson String?      @db.Text
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taxCode          TaxCode      @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, taxKind, createdAt])
}

// ---------------------------------------------------------------------------
// 6. AR payment allocations (many-to-many payment <-> invoice)
// ---------------------------------------------------------------------------

model PaymentAllocation {
  id               String          @id @default(uuid())
  organizationId   String
  paymentId        String
  salesInvoiceId   String
  amount           Decimal         @db.Decimal(14, 2)
  allocatedAt      DateTime        @default(now())
  createdBy        String?

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment          CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  salesInvoice     SalesInvoice    @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, salesInvoiceId])
  @@index([organizationId, salesInvoiceId])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// 7. Accounts payable subledger
// ---------------------------------------------------------------------------

model SupplierBill {
  id                String             @id @default(uuid())
  organizationId    String
  branchId          String
  supplierId        String
  billNumber        String             // supplier's own invoice number
  internalNumber    String
  billDate          DateTime
  dueDate           DateTime
  currency          CurrencyCode       @default(KES)
  exchangeRate      Decimal            @default(1.00000000) @db.Decimal(18, 8)
  subtotal          Decimal            @db.Decimal(14, 2)
  taxAmount         Decimal            @default(0.00) @db.Decimal(14, 2)
  whtAmount         Decimal            @default(0.00) @db.Decimal(14, 2)
  totalAmount       Decimal            @db.Decimal(14, 2)
  paidAmount        Decimal            @default(0.00) @db.Decimal(14, 2)
  status            SupplierBillStatus @default(DRAFT)
  purchaseOrderId   String?
  goodsReceiptRef   String?            // real GRN reference only; never fabricated
  duplicateHash     String?
  postedJournalId   String?
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines             SupplierBillLine[]
  allocations       SupplierPaymentAllocation[]

  @@unique([organizationId, internalNumber])
  @@unique([organizationId, supplierId, billNumber])
  @@index([organizationId, status, dueDate])
  @@index([supplierId])
  @@index([branchId])
}

model SupplierBillLine {
  id               String       @id @default(uuid())
  supplierBillId   String
  description      String
  quantity         Decimal      @default(1.00) @db.Decimal(12, 2)
  unitPrice        Decimal      @db.Decimal(14, 2)
  taxCodeId        String?
  taxAmount        Decimal      @default(0.00) @db.Decimal(14, 2)
  whtAmount        Decimal      @default(0.00) @db.Decimal(14, 2)
  lineTotal        Decimal      @db.Decimal(14, 2)
  expenseAccountId String
  costCentreId     String?
  createdAt        DateTime     @default(now())

  supplierBill     SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  costCentre       CostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@index([supplierBillId])
  @@index([expenseAccountId])
  @@index([costCentreId])
}

model SupplierPayment {
  id               String          @id @default(uuid())
  organizationId   String
  branchId         String
  supplierId       String
  paymentNumber    String
  paymentDate      DateTime
  amount           Decimal         @db.Decimal(14, 2)
  currency         CurrencyCode    @default(KES)
  exchangeRate     Decimal         @default(1.00000000) @db.Decimal(18, 8)
  paymentMethod    String
  referenceCode    String
  whtAmount        Decimal         @default(0.00) @db.Decimal(14, 2)
  unappliedAmount  Decimal         @default(0.00) @db.Decimal(14, 2)
  status           PaymentStatus   @default(DRAFT)
  bankAccountId    String?
  postedJournalId  String?
  approvedBy       String?
  approvedAt       DateTime?
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations      SupplierPaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, supplierId, paymentDate])
}

model SupplierPaymentAllocation {
  id                String            @id @default(uuid())
  organizationId    String
  supplierPaymentId String
  supplierBillId    String
  amount            Decimal           @db.Decimal(14, 2)
  allocatedAt       DateTime          @default(now())
  createdBy         String?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplierPayment   SupplierPayment   @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  supplierBill      SupplierBill      @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)

  @@unique([supplierPaymentId, supplierBillId])
  @@index([organizationId, supplierBillId])
}

// ---------------------------------------------------------------------------
// 8. Banking and reconciliation
// ---------------------------------------------------------------------------

model BankAccount {
  id               String          @id @default(uuid())
  organizationId   String
  branchId         String?
  name             String
  type             BankAccountType @default(BANK)
  accountNumber    String?
  glAccountId      String
  currency         CurrencyCode    @default(KES)
  provider         String?         // e.g. "EQUITY", "KCB", "MPESA"
  mpesaShortcode   String?
  openingBalance   Decimal         @default(0.00) @db.Decimal(14, 2)
  openingDate      DateTime?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  glAccount        Account         @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  statements       BankStatement[]
  reconciliations  BankReconciliation[]
  mpesaTransactions MpesaTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([glAccountId])
}

model BankStatement {
  id               String       @id @default(uuid())
  organizationId   String
  bankAccountId    String
  fileName         String?
  fileHash         String       // SHA-256 of the imported file; blocks duplicate imports
  format           String       @default("CSV")
  statementFrom    DateTime
  statementTo      DateTime
  openingBalance   Decimal      @db.Decimal(14, 2)
  closingBalance   Decimal      @db.Decimal(14, 2)
  lineCount        Int          @default(0)
  importedBy       String?
  importedAt       DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  lines            BankStatementLine[]

  @@unique([organizationId, bankAccountId, fileHash])
  @@index([organizationId, bankAccountId, statementTo])
}

model BankStatementLine {
  id                 String              @id @default(uuid())
  statementId        String
  lineNumber         Int
  valueDate          DateTime
  description        String
  reference          String?
  debit              Decimal             @default(0.00) @db.Decimal(14, 2)
  credit             Decimal             @default(0.00) @db.Decimal(14, 2)
  balanceAfter       Decimal?            @db.Decimal(14, 2)
  fingerprint        String              // hash(valueDate, amount, reference, description)
  status             StatementLineStatus @default(UNMATCHED)
  matchedTargetType  String?
  matchedTargetId    String?
  createdAt          DateTime            @default(now())

  statement          BankStatement       @relation(fields: [statementId], references: [id], onDelete: Restrict)
  matches            BankMatch[]

  @@unique([statementId, fingerprint])
  @@index([statementId, status])
  @@index([valueDate])
}

model BankReconciliation {
  id                      String               @id @default(uuid())
  organizationId          String
  bankAccountId           String
  periodStart             DateTime
  periodEnd               DateTime
  statementClosingBalance Decimal              @db.Decimal(14, 2)
  glClosingBalance        Decimal              @db.Decimal(14, 2)
  difference              Decimal              @db.Decimal(14, 2)
  status                  ReconciliationStatus @default(DRAFT)
  preparedBy              String?
  finalizedBy             String?
  finalizedAt             DateTime?
  reversalReason          String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount             BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  matches                 BankMatch[]

  @@index([organizationId, bankAccountId, status])
  @@index([organizationId, periodEnd])
}

model BankMatch {
  id               String                  @id @default(uuid())
  organizationId   String
  reconciliationId String
  statementLineId  String
  targetType       String                  // JOURNAL_LINE / CUSTOMER_PAYMENT / SUPPLIER_PAYMENT / BANK_FEE
  targetId         String
  amount           Decimal                 @db.Decimal(14, 2)
  matchType        ReconciliationMatchType @default(MANUAL)
  reason           String?
  matchedBy        String?
  matchedAt        DateTime                @default(now())

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reconciliation   BankReconciliation      @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  statementLine    BankStatementLine       @relation(fields: [statementLineId], references: [id], onDelete: Restrict)

  @@unique([statementLineId, targetType, targetId])
  @@index([organizationId, reconciliationId])
}

// ---------------------------------------------------------------------------
// 9. M-Pesa (Safaricom Daraja) transaction ledger
// ---------------------------------------------------------------------------

model MpesaTransaction {
  id                String                  @id @default(uuid())
  organizationId    String
  bankAccountId     String?
  transactionType   MpesaTransactionType
  merchantRequestId String?
  checkoutRequestId String?
  mpesaReceiptNumber String?
  phoneNumber       String?
  amount            Decimal                 @db.Decimal(14, 2)
  currency          CurrencyCode            @default(KES)
  status            MpesaTransactionStatus  @default(REQUESTED)
  resultCode        String?
  resultDesc        String?
  accountReference  String?
  rawPayloadJson    String?                 @db.Text
  idempotencyKey    String                  @unique
  customerPaymentId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount       BankAccount?            @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, mpesaReceiptNumber])
  @@index([checkoutRequestId])
}

// ---------------------------------------------------------------------------
// 10. Budgets
// ---------------------------------------------------------------------------

model Budget {
  id             String       @id @default(uuid())
  organizationId String
  fiscalYearId   String
  name           String
  version        Int          @default(1)
  status         BudgetStatus @default(DRAFT)
  costCentreId   String?
  notes          String?
  createdBy      String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lines          BudgetLine[]

  @@unique([organizationId, fiscalYearId, name, version])
  @@index([organizationId, status])
}

model BudgetLine {
  id             String       @id @default(uuid())
  organizationId String
  budgetId       String
  accountId      String
  periodNumber   Int          // 1..12 within the fiscal year
  amount         Decimal      @db.Decimal(14, 2)
  costCentreId   String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  budget         Budget       @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCentre     CostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@unique([budgetId, accountId, periodNumber, costCentreId])
  @@index([organizationId, accountId])
}

// ---------------------------------------------------------------------------
// 11. Domain event outbox and atomic document numbering
// ---------------------------------------------------------------------------

model DomainEventLog {
  id             String             @id @default(uuid())
  organizationId String
  eventType      String             // e.g. "journal.posted", "invoice.posted"
  aggregateType  String
  aggregateId    String
  payloadJson    String             @db.Text
  status         DomainEventStatus  @default(PENDING)
  attempts       Int                @default(0)
  lastError      String?
  createdAt      DateTime           @default(now())
  publishedAt    DateTime?

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([aggregateType, aggregateId])
}

model DocumentSequence {
  id             String       @id @default(uuid())
  organizationId String
  prefix         String       // "JE", "INV", "RCPT", "BILL", "PAY", "CN"
  scope          String       @default("GLOBAL") // e.g. branch id
  year           Int
  nextValue      Int          @default(1)
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, prefix, scope, year])
}